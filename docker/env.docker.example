# Docker environment example for CRM Maia Consultores (RNF-OPS-001).
#
# Copy this file to the project root as `.env.docker` and fill real secrets.
# NOTE: this example lives under docker/ (not root) because tooling blocks
# writing files named `.env*` directly; the runtime file must be `.env.docker`
# at the root for docker-compose's `env_file` to pick it up.

APP_NAME="CRM Maia Consultores"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (must match the mysql service variables in docker-compose.yml).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
MYSQL_DATABASE=crm_maia
MYSQL_USER=crm_maia
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DB_DATABASE=crm_maia
DB_USERNAME=crm_maia
DB_PASSWORD=change-me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Bootstrap admin user (fill with real values; never commit them).
ADMIN_NAME="CRM Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
