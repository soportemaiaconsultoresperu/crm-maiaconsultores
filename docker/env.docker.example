# Docker environment example for CRM Maia Consultores.
#
# Copy this file to the project root as `.env.docker`, fill the empty secret
# values, then run Docker Compose with `--env-file .env.docker`.

APP_NAME="CRM Maia Consultores"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://crm.maiaconsultores.com
# Required contact address for Caddy's Let's Encrypt account registration.
CADDY_EMAIL=
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database. MySQL is private to the Compose network; do not add a host port.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
MYSQL_DATABASE=crm_maia
MYSQL_USER=crm_maia
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_DATABASE=crm_maia
DB_USERNAME=crm_maia
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Bootstrap application admin (not the MySQL user). The normal DatabaseSeeder
# creates or updates this user and grants the application admin role.
ADMIN_NAME="CRM Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
